# AEGIS CREW environment template.
# Copy to `.env` (git-ignored) and fill in real values. Never commit `.env`.
# Requirement 2.11: the signer key is read only from the environment and is
# never written to logs, the UI, or storage. Only the chain-state MCP server
# process reads it (live mode); the server ignores unexpanded "${...}" values.

# Chain-state MCP server mode: `mock` (fixtures, no network, no signing) or `live`.
AEGIS_CHAIN_MODE=mock

# NEAR account that calls aegis-guard.request_pause (Requirement 2.7).
AEGIS_SIGNER_ACCOUNT_ID=test-account.testnet

# Function-call access key for AEGIS_SIGNER_ACCOUNT_ID, restricted to the Aegis
# Guard contract's `request_pause` method (it cannot attach deposits; the guard
# pays the MPC sign deposit). Placeholder only; not a real key.
AEGIS_SIGNER_KEY=ed25519:mock_private_key_for_hackathon
