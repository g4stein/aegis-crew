{
  "mcpServers": {
    "chain-state": {
      "command": "node",
      "args": ["aegis-sentinel/mcp/chain-state-server.mjs"],
      "env": {
        "AEGIS_CHAIN_MODE": "mock",
        "AEGIS_TOOL_SCHEMA": ".kiro/mcp/chain-state-mcp.json",
        "AEGIS_SIGNER_ACCOUNT_ID": "${AEGIS_SIGNER_ACCOUNT_ID}",
        "AEGIS_SIGNER_KEY": "${AEGIS_SIGNER_KEY}"
      },
      "disabled": false,
      "autoApprove": ["get_contract_invariants", "get_mitigation_status"],
      "disabledTools": []
    }
  }
}
